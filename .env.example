# HERE you can add your environment variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site-wide maintenance gate.
# "true" replaces every public page with the branded maintenance screen.
MAINTENANCE_MODE=false
# Secret that unlocks the real site for your own browser:
# visit https://<site>/?preview=<token> once, and a cookie keeps you in for 7 days.
# Keep this out of version control (set it in .env.local or your host's env vars).
MAINTENANCE_BYPASS_TOKEN=
